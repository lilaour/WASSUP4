


import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import matplotlib as mpl
mpl.rc('font', family='Malgun Gothic')  # Windows의 경우


#데이터 불러오기
data = pd.read_table('data/mini.csv',sep=',')


#데이터 정보확인
data.head()


data.describe()





# 그래프 생성
plt.figure(figsize=(12, 6))
sns.histplot(data=data, x='recent_login_time', hue='target', multiple='stack', bins=30, alpha=0.7)

# 그래프 설정
plt.title('구독 여부에 따른 최근 로그인 시간 분포', fontsize=16)
plt.xlabel('최근 로그인 시간 (일)', fontsize=14)
plt.ylabel('유저 수', fontsize=14)
plt.legend(title='구독 여부', labels=['구독안함 (0)', '구독함 (1)'])
plt.grid(True)
plt.show()


# 구독 여부에 따른 평균 학습 세션 시간 계산
average_session_time = data.groupby('target')['average_time_per_learning_session'].mean().reset_index()

# 막대 그래프 생성
plt.figure(figsize=(10, 6))
sns.barplot(x='target', y='average_time_per_learning_session', data=average_session_time, palette='Set2')

# 그래프 설정
plt.title('구독 여부에 따른 평균 학습 세션 시간', fontsize=16)
plt.xlabel('구독 여부 (1: 구독함, 0: 구독안함)', fontsize=14)
plt.ylabel('평균 학습 세션 시간 (분)', fontsize=14)
plt.xticks(ticks=[0, 1], labels=['구독안함', '구독함'])
plt.grid(axis='y')
plt.show()


# 그래프 생성
plt.figure(figsize=(10, 6))
sns.scatterplot(x='average_time_per_learning_session', y='target', data=data, alpha=0.6)
sns.regplot(x='average_time_per_learning_session', y='target', data=data, logistic=True, color='red')

# 그래프 설정
plt.title('평균 학습 세션 시간과 구독 여부의 관계', fontsize=16)
plt.xlabel('평균 학습 세션 시간 (분)', fontsize=14)
plt.ylabel('구독 여부 (1: 구독함, 0: 구독안함)', fontsize=14)
plt.yticks([0, 1], ['구독안함', '구독함'])
plt.grid(True)
plt.show()












