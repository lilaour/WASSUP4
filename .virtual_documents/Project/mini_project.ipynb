avg_time_by_subscription = data.groupby('target')['average_time_per_learning_session'].mean().reset_index()

# 막대그래프 그리기
plt.figure(figsize=(8, 5))
sns.barplot(x='target', y='average_time_per_learning_session', data=avg_time_by_subscription, palette='Blues')
plt.title('Average Learning Session Time by Subscription Continuation')
