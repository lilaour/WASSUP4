plt.grid(axis='y')
plt.show()


# 수치형 변수만 선택
numeric_data = data.select_dtypes(include=['float64', 'int64'])

# target과 각 수치형 변수 간의 상관계수 계산
correlation = numeric_data.corr()['target'].drop('target')

# 바 차트 그리기
plt.figure(figsize=(10, 6))
correlation.plot(kind='bar', color='skyblue', alpha=0.7)
plt.title('Correlation with Target Variable')
plt.xlabel('Features')
plt.ylabel('Correlation Coefficient')
plt.xticks(rotation=45)

# 음수 기호에 대한 처리
for i, v in enumerate(correlation):
    plt.text(i, v + 0.01 if v > 0 else v - 0.05, f'{v:.2f}', ha='center')

plt.axhline(0, color='black', linewidth=0.8)
plt.grid(axis='y')
plt.show()






